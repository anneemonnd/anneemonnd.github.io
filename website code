function show(id, btn) {
  document.querySelectorAll('.section').forEach(s=>s.classList.remove('show'));
  document.getElementById(id).classList.add('show');
  document.querySelectorAll('.tn-item').forEach(b=>b.classList.remove('act'));
  if(btn && btn.classList.contains('tn-item')) btn.classList.add('act');
}
function showYear(id, btn) {
  document.querySelectorAll('.course-panel').forEach(p=>p.classList.remove('show'));
  document.getElementById(id).classList.add('show');
  document.querySelectorAll('.ytab').forEach(b=>b.classList.remove('act'));
  btn.classList.add('act');
}
function filterCourses(q) {
  var sr=document.getElementById('search-results');
  var yn=document.getElementById('year-nav');
  var grid=document.getElementById('sr-grid');
  if(!q.trim()){sr.style.display='none';yn.style.display='block';return;}
  var hits=courses.filter(c=>c.sigle.toLowerCase().includes(q.toLowerCase())||c.name.toLowerCase().includes(q.toLowerCase()));
  sr.style.display='block';yn.style.display='none';
  if(!hits.length){grid.innerHTML='<div class="card" style="grid-column:1/-1"><p class="body">Aucun cours trouvé.</p></div>';return;}
  grid.innerHTML=hits.map(c=>`<div class="course-item"><div class="ci-sigle">${c.sigle}</div><div class="ci-name">${c.name}</div><div class="ci-meta">${c.year} · ${c.meta}</div></div>`).join('');
